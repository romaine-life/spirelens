<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <!-- Godot.NET.Sdk defaults to false here; we need true so Mono.Cecil
             and other NuGet deps land in bin/Release for us to copy into mods/. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <BaseLibVersion>3.4.8</BaseLibVersion>
        <BaseLibReleaseUrl>https://github.com/Alchyr/BaseLib-StS2/releases/download/v$(BaseLibVersion)</BaseLibReleaseUrl>
        <BaseLibHelperDir>$(MSBuildProjectDirectory)/obj/baselib-release/$(BaseLibVersion)/</BaseLibHelperDir>
        <!-- The release's version (prefix.N), which the CI suites' release build sets. -->
        <SpireLensReleaseVersion>$(InformationalVersion)</SpireLensReleaseVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn> 
    </PropertyGroup>

    <PropertyGroup>
        <Sts2LibDir Condition="'$(Sts2DataDir)' != '' and Exists('$(Sts2DataDir)')">$(Sts2DataDir)</Sts2LibDir>
        <Sts2LibDir Condition="'$(Sts2LibDir)' == ''">$(MSBuildThisFileDirectory)lib</Sts2LibDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2LibDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2LibDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    
    <ItemGroup Condition="True"> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="$(BaseLibVersion)" PrivateAssets="All" GeneratePathProperty="true"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.9" />
        <!-- Mono.Cecil: rewrites the Core assembly's manifest name per load so
             the ALC treats each reload as a distinct assembly. Without this,
             .NET dedupes by short name and hot reload silently no-ops. -->
        <PackageReference Include="Mono.Cecil" Version="0.11.5" />
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <!-- <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" /> -->
        <AdditionalFiles Include="SpireLens/localization/**/*.json"/> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <!-- Loader-only compile scope. Core is a separate csproj and builds its own DLL.
             If we don't explicitly exclude Core/, the default glob in Godot.NET.Sdk
             will sweep it in and we'd get duplicate type definitions. -->
        <Compile Remove="Core/**" />
        <Compile Remove="Tests/**" />
        <Compile Remove="SpireLens/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="Core/**" />
        <EmbeddedResource Remove="Tests/**" />
        <EmbeddedResource Remove="SpireLens/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
        <None Remove="Core/**" />
        <None Remove="Tests/**" />
    </ItemGroup>

    <ItemGroup>
        <!-- Built and restored with the Loader so its publish can ship Core; never referenced,
             since the Loader loads Core from a path at runtime. -->
        <ProjectReference Include="Core/SpireLens.Core.csproj" ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="SpireLens.json" />
        <None Include="project.godot"/>
        <None Include="SpireLens/**" />
    </ItemGroup>
    
    <Target Name="CheckDependencyPaths" >
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)' and reference stubs not found at '$(Sts2LibDir)'"
                Condition="('$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')) and !Exists('$(Sts2LibDir)/sts2.dll')" />
    </Target>

    <Target Name="GenerateSpireLensBuildInfo" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <SpireLensBuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("O"))</SpireLensBuildTimestampUtc>
            <SpireLensBuildSource>Local</SpireLensBuildSource>
        </PropertyGroup>
        <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" ItemName="_SpireLensGitCommitOutput" />
        </Exec>
        <PropertyGroup>
            <SpireLensGitCommitHash>@(_SpireLensGitCommitOutput)</SpireLensGitCommitHash>
            <SpireLensGitCommitHash Condition="'$(SpireLensGitCommitHash)' == ''">unknown</SpireLensGitCommitHash>
            <SpireLensBuildSource Condition="'$(GITHUB_ACTIONS)' == 'true'">GitHub</SpireLensBuildSource>
            <SpireLensBuildSource Condition="'$(GITHUB_SERVER_URL)' == 'https://forgejo.romaine.life'">Forgejo</SpireLensBuildSource>
            <SpireLensBuildVersion>$(SpireLensGitCommitHash)</SpireLensBuildVersion>
            <SpireLensBuildVersion Condition="'$(SpireLensReleaseVersion)' != ''">$(SpireLensReleaseVersion)</SpireLensBuildVersion>
        </PropertyGroup>
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
            <_SpireLensBuildInfoLines Include="// &lt;auto-generated /&gt;" />
            <_SpireLensBuildInfoLines Include="namespace SpireLens.Config" />
            <_SpireLensBuildInfoLines Include="{" />
            <_SpireLensBuildInfoLines Include="internal static class BuildInfo" />
            <_SpireLensBuildInfoLines Include="{" />
            <_SpireLensBuildInfoLines Include="    public const string Version = &quot;$(SpireLensBuildVersion)&quot;%3B" />
            <_SpireLensBuildInfoLines Include="    public const string CommitHash = &quot;$(SpireLensGitCommitHash)&quot;%3B" />
            <_SpireLensBuildInfoLines Include="    public const string Source = &quot;$(SpireLensBuildSource)&quot;%3B" />
            <_SpireLensBuildInfoLines Include="    public const string BuildTimestampUtc = &quot;$(SpireLensBuildTimestampUtc)&quot;%3B" />
            <_SpireLensBuildInfoLines Include="}" />
            <_SpireLensBuildInfoLines Include="}" />
        </ItemGroup>
        <WriteLinesToFile
            File="$(IntermediateOutputPath)BuildInfo.g.cs"
            Lines="@(_SpireLensBuildInfoLines)"
            Overwrite="true" />
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipModsDeploy)' != 'true' and Exists('$(Sts2Path)')">
        <Message Text="Copying .dll, manifest, and dependencies to mods folder." Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(AssemblyName).json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <!-- BaseLib is a real STS2 mod dependency, not only a DLL reference.
             Keep the worker's mods/BaseLib folder present whenever we deploy.
             BaseLib.json depends on BaseLibCompatibilityHelper, which ships only
             in the BaseLib GitHub release (not the NuGet package) and installs
             into the same folder. -->
        <DownloadFile SourceUrl="$(BaseLibReleaseUrl)/BaseLibCompatibilityHelper.dll" DestinationFolder="$(BaseLibHelperDir)" SkipUnchangedFiles="true" />
        <DownloadFile SourceUrl="$(BaseLibReleaseUrl)/BaseLibCompatibilityHelper.json" DestinationFolder="$(BaseLibHelperDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <BaseLibModFiles Include="$(TargetDir)BaseLib.dll" />
            <BaseLibModFiles Include="$(PkgAlchyr_Sts2_BaseLib)\Content\BaseLib.json" />
            <BaseLibModFiles Include="$(PkgAlchyr_Sts2_BaseLib)\Content\BaseLib.pck" />
            <BaseLibModFiles Include="$(BaseLibHelperDir)BaseLibCompatibilityHelper.dll" />
            <BaseLibModFiles Include="$(BaseLibHelperDir)BaseLibCompatibilityHelper.json" />
        </ItemGroup>
        <Copy SourceFiles="@(BaseLibModFiles)" DestinationFolder="$(ModsPath)BaseLib/" SkipUnchangedFiles="true" />
        <!-- Copy NuGet dependency DLLs (Mono.Cecil, its companions) alongside
             the Loader so CLR assembly resolution finds them at runtime.
             Filter to avoid copying huge framework assemblies by accident. -->
        <ItemGroup>
            <LoaderRuntimeDeps Include="$(TargetDir)Mono.Cecil*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(LoaderRuntimeDeps)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
    </Target>

    <Target Name="CopyQuickPck" AfterTargets="PackPck" Condition="Exists('$(PckPackerOutputPath)') And '$(PckPackerSkipped)' != 'true' And '$(SkipModsDeploy)' != 'true' And Exists('$(Sts2Path)')">
        <Message Text="Copying quick .pck to mods folder." Importance="high"/>
        <Copy SourceFiles="$(PckPackerOutputPath)"
              DestinationFolder="$(ModsPath)/$(MSBuildProjectName)" />
    </Target>

    <!-- dotnet publish lays out the mod folder players install: the Loader, its Mono.Cecil
         dependencies, Core, and the manifest carrying the release's version. -->
    <Target Name="PublishModFolder" AfterTargets="Publish">
        <MSBuild Projects="Core/SpireLens.Core.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_SpireLensCoreAssembly" />
        </MSBuild>
        <PropertyGroup>
            <_SpireLensManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/$(AssemblyName).json').TrimEnd())</_SpireLensManifest>
            <_SpireLensManifest Condition="'$(SpireLensReleaseVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(_SpireLensManifest), '"version":\s*"[^"]*"', '"version": "$(SpireLensReleaseVersion)"'))</_SpireLensManifest>
        </PropertyGroup>
        <ItemGroup>
            <_SpireLensPublished Include="@(ResolvedFileToPublish->'$(PublishDir)%(RelativePath)')" />
            <_SpireLensPublished Include="$(PublishDir)$(AssemblyName).deps.json" />
            <_SpireLensPublished Remove="$(PublishDir)$(TargetFileName);$(PublishDir)Mono.Cecil*.dll" />
        </ItemGroup>
        <Delete Files="@(_SpireLensPublished)" />
        <Copy SourceFiles="@(_SpireLensCoreAssembly)" DestinationFolder="$(PublishDir)" />
        <WriteLinesToFile File="$(PublishDir)$(AssemblyName).json" Lines="$([MSBuild]::Escape($(_SpireLensManifest)))" Overwrite="true" />
    </Target>

    <!-- The BaseLib that SpireLens pins, laid out as the game's mods\BaseLib\ folder beside the
         mod's own. The release suite publishes each folder of its output as a signed ZIP, so
         every release carries BaseLib-windows.zip at exactly this pin, and home-sync installs
         it beside SpireLens (SPIRELENS-103). The Workshop package stays SpireLens-windows.zip. -->
    <Target Name="PublishBaseLibFolder" AfterTargets="PublishModFolder">
        <PropertyGroup>
            <_BaseLibPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)../BaseLib/'))</_BaseLibPublishDir>
        </PropertyGroup>
        <DownloadFile SourceUrl="$(BaseLibReleaseUrl)/BaseLibCompatibilityHelper.dll" DestinationFolder="$(BaseLibHelperDir)" SkipUnchangedFiles="true" />
        <DownloadFile SourceUrl="$(BaseLibReleaseUrl)/BaseLibCompatibilityHelper.json" DestinationFolder="$(BaseLibHelperDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <_BaseLibPublished Include="$(TargetDir)BaseLib.dll" />
            <_BaseLibPublished Include="$(PkgAlchyr_Sts2_BaseLib)\Content\BaseLib.json" />
            <_BaseLibPublished Include="$(PkgAlchyr_Sts2_BaseLib)\Content\BaseLib.pck" />
            <_BaseLibPublished Include="$(BaseLibHelperDir)BaseLibCompatibilityHelper.dll" />
            <_BaseLibPublished Include="$(BaseLibHelperDir)BaseLibCompatibilityHelper.json" />
        </ItemGroup>
        <Error Condition="!Exists('%(_BaseLibPublished.FullPath)')" Text="BaseLib's mod folder is missing %(_BaseLibPublished.Filename)%(_BaseLibPublished.Extension)." />
        <Copy SourceFiles="@(_BaseLibPublished)" DestinationFolder="$(_BaseLibPublishDir)" />
    </Target>
</Project>
